# Credenciales de LiveKit Cloud (https://cloud.livekit.io -> Settings -> Keys)
# El STT, LLM y TTS se resuelven a través de LiveKit Inference, así que no
# necesitas claves aparte de OpenAI ni de Deepgram.
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Sistema de pedidos de Brasa & Pan (demo-delivery-system).
# El agente NO tiene base de datos propia: lee el catálogo y crea los pedidos
# contra estos endpoints. DELIVERY_API_URL es la app del menú (la que sirve
# /api/internal/catalog y /api/internal/voice-order).
#
# INTERNAL_SECRET tiene que ser EXACTAMENTE el mismo valor que tienen las tres
# apps del sistema de pedidos, o el catálogo responde 401 y la llamada no
# arranca.
DELIVERY_API_URL=https://brasa-y-pan-menu.vercel.app
INTERNAL_SECRET=

# El número real de WhatsApp del restaurante, sin + ni espacios. Es a donde se
# manda al cliente cuando la llamada no puede terminar en pedido (los tres
# caminos de respaldo). Sin esto, el respaldo dice "escríbenos por WhatsApp"
# sin poder darle a dónde.
BUSINESS_WHATSAPP_NUMBER=

# Modelos de LLM y STT, configurables para poder comparar variantes sin
# tocar código (ver scripts/bench_llm.py). La voz (TTS) queda fija en
# agent.py a propósito y no se parametriza aquí.
LLM_MODEL=openai/gpt-4.1-mini
STT_MODEL=deepgram/flux-general-multi

# Aviso de asistente virtual / grabación (Ley 1581 de 2012). Apagado en
# demo; actívalo cuando esto atienda llamadas telefónicas reales.
AVISO_LEGAL=false
