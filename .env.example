# Credenciales de LiveKit Cloud (https://cloud.livekit.io -> Settings -> Keys)
# El STT, LLM y TTS se resuelven a través de LiveKit Inference, así que no
# necesitas claves aparte de OpenAI ni de Deepgram.
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Base de datos Postgres.
# Estos son los valores por defecto que levanta docker-compose.yml;
# solo cámbialos si usas una base de datos distinta.
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=password
DB_NAME=chicken_store
